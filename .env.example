# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# .env.local NÃO vai para o controle de versão.
#
# Onde achar: painel do Supabase > Project Settings > API
#
# ATENÇÃO: use a chave "anon" / "publishable". Ela é pública de propósito e vai
# embutida no site. NUNCA coloque aqui a chave "service_role" — ela ignora o
# RLS e daria acesso total ao banco para qualquer visitante.

# A chave pública mudou de nome no Supabase: projetos novos mostram
# "publishable" (sb_publishable_...), antigos mostram "anon" (eyJhbGci...).
# O site aceita qualquer um dos dois nomes de variável.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-chave-publishable
# VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon   (projetos antigos)
